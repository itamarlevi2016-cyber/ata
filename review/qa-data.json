    "transcript": "נתחיל בתנועות. פתחו את הפה היטב ותנו לכל תנועה את מלוא הצורה שלה.",
    "source_text_matches": "כן",
    "flags": "",
    "technical_flags": "התחלה קרובה לדיבור — להאזין לחיתוך",
