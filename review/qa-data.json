    "audio": "audio/projection-0.mp3",
    "seconds": 7.27,
    "transcript": "הקרנה היא לא צעקה. זה קול שנתמך מהנשימה ומגיע לקצה החדר בלי מאמץ בגרון.",
    "source_text_matches": "כן",
    "flags": "",
    "technical_flags": "",
