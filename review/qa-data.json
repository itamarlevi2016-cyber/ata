    "lesson": "דיקציה ובהירות",
    "audio": "audio/diction-6.mp3",
    "seconds": 6.15,
    "transcript": "קראו את הקטע בקול, לאט, ובהגייה ברורה. שימו לב לסימני ההפסקה.",
    "source_text_matches": "כן",
    "flags": "",
    "technical_flags": "",
