    "lesson": "הקרנה ועוצמה",
    "audio": "audio/projection-3.mp3",
    "seconds": 7.64,
    "transcript": "ספרו מאחת עד חמש. בכל מספר הגדילו קצת את התמיכה מהבטן, כשהגרון נשאר רפוי.",
    "source_text_matches": "כן",
    "flags": "",
    "technical_flags": "",
    "audio_hash": "620cc8c2ae4d252b70ac234666bd4859af036b2103e45926697c820b2fad0bc3"
