# העתיקו לקובץ בשם .env ומלאו לפי הצורך

# טוקן Hugging Face — נדרש רק לזיהוי דוברים, ורק להורדה הראשונה של המודל
HF_TOKEN=

# תמלול בענן (אופציונלי) — ראו README, סעיף "תמלול בענן"
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# מודל התמלול (ברירת מחדל: מודל turbo מהיר של ivrit.ai).
# למחשב חזק במיוחד אפשר לנסות: ivrit-ai/whisper-large-v3-ct2
# ATA_WHISPER_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2

# auto / cuda / cpu
# ATA_DEVICE=auto

# מילים מתחת לסף הזה יסומנו לבדיקה (0 עד 1)
# ATA_LOW_CONFIDENCE=0.6
